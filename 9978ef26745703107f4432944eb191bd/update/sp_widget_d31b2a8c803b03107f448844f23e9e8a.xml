        <name>CampusOps Asset Details</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    data.found = false;

    var sysId = $sp.getParameter('sys_id');

    if (!sysId)
        return;

    var asset = new GlideRecord('u_campus_asset');

    if (!asset.get(sysId))
        return;

    data.found = true;

    data.asset = {
        name: asset.getDisplayValue('u_asset_name'),
        type: asset.getDisplayValue('u_asset_type'),
        location: asset.getDisplayValue('u_location'),
        status: asset.getDisplayValue('u_status'),
        condition: asset.getDisplayValue('u_condition'),
        maintenance: asset.getDisplayValue('u_maintenance_status'),
        rentalPrice: asset.getDisplayValue('u_rental_price')
    };

})();]]></script>
